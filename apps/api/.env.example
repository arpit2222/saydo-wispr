PORT=4000
NODE_ENV=development
API_URL=http://localhost:4000
WEB_URL=http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:4000

# ==============================================================================
# AI Provider: Azure OpenAI (Recommended for Wispr Challenge)
# ==============================================================================
# If configured, SayDo routes schema extraction, multi-step planning, and agent
# tool execution through your Azure OpenAI deployment (e.g. gpt-4o-mini).
# If omitted, SayDo automatically activates its built-in offline deterministic
# neuro-symbolic engine so the demo never fails!
AZURE_OPENAI_API_KEY=your_azure_api_key_here
AZURE_OPENAI_ENDPOINT=https://your-resource-name.openai.azure.com/
AZURE_OPENAI_DEPLOYMENT=gpt-4o-mini
AZURE_OPENAI_API_VERSION=2024-08-01-preview

# Optional: Standard OpenAI API fallback
# OPENAI_API_KEY=your_openai_api_key

# ==============================================================================
# Database Persistence (Optional)
# ==============================================================================
# If omitted, SayDo uses high-performance in-memory persistence (mockDb)
# pre-seeded with all DEHIX skills, policies, and runs.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Security Token
AGENT_TOKEN=saydo_secure_mcp_agent_token_secret
