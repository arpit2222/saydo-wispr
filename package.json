{
  "name": "saydo",
  "private": true,
  "scripts": {
    "dev": "turbo run dev --filter=@saydo/web --filter=@saydo/api --parallel",
    "dev:all": "turbo run dev --parallel",
    "copy:sdk": "mkdir -p apps/web/public && cp packages/sdk/dist/sdk.js apps/web/public/sdk.js",
    "build": "turbo run build && pnpm run copy:sdk",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "smoke-test": "node scripts/smoke-test.mjs"
  },
  "devDependencies": {
    "next": "^14.2.24",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "turbo": "^2.4.4",
    "typescript": "^5.7.3"
  },
  "packageManager": "pnpm@10.33.2",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2"
  }
}
